<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (plain HTTP) stays off everywhere except the loopback hosts a
     developer uses to reach a local MK-Flix backend while testing: the Android
     emulator sees the host machine as 10.0.2.2, and a device bridged with
     `adb reverse` sees it as 127.0.0.1. The production backend is HTTPS, so
     this permits nothing reachable from a shipped app in the field. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
