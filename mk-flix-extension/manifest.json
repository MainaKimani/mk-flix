{
  "manifest_version": 3,
  "name": "Blendy Play",
  "version": "1.0.0",
  "description": "Blendy Play in your browser: ad-free watching, powered by CineJoy.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Blendy Play",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "webNavigation", "declarativeNetRequest"],
  "host_permissions": [
    "*://cinejoy.pk/*",
    "*://*.cinejoy.pk/*",
    "https://blendyplay.mainakimani.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://cinejoy.pk/*", "*://*.cinejoy.pk/*"],
      "css": ["mkflix-logo.css"],
      "js": ["bridge-relay.js", "tab-brand.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "adblock-rules.json" }
    ]
  }
}
