{
  "name": "blendy-play",
  "productName": "Blendy Play",
  "version": "1.4.0",
  "description": "Blendy Play desktop app for Windows and Linux: ad-free watching on the big screen",
  "author": {
    "name": "Blendy Studio",
    "email": "alexroymauk@gmail.com"
  },
  "homepage": "https://github.com/MainaKimani/mk-flix",
  "desktopName": "blendy-play.desktop",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist-win": "electron-builder --win nsis --x64",
    "dist-linux": "electron-builder --linux deb"
  },
  "build": {
    "appId": "com.mainakimani.blendyplay",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "mkflix-logo.css",
      "mkflix-footer.js",
      "adblock-hosts.txt",
      "icon.png",
      "error.html",
      "splash.html",
      "splash-wordmark.png",
      "mkflix-account.html",
      "mkflix-enforcer.js",
      "mkflix-menu.js",
      "mkflix-lock.js",
      "mkflix-config.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "executableName": "blendy-play",
      "icon": "icon.png",
      "category": "AudioVideo",
      "synopsis": "Blendy Play: Powered by CineJoy",
      "desktop": {
        "entry": {
          "Name": "Blendy Play",
          "GenericName": "Video streaming",
          "Comment": "Watch cinejoy.pk, ad-free, in its own window"
        }
      },
      "artifactName": "Blendy-Play_${version}_${arch}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "blendy-play"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blendy Play",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Blendy-Play-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
